-- Arrays (collections, context.md §64): functions over a pure array, taken as `xs: []T` and its
-- length read as `xs.len`; each is made once per type, length and function given (nothing is
-- passed at run time for them, and a small function given is inlined). Written in Modal: a loop is a recursion that ends with an arm on i.
type := import("./type").type

-- map: a new array, f of each element.
map(T: type, U: type, xs: []T, f: function(T): U): [xs.len]U {
    [xs.len]U out
    map_into(T, U, xs, &out, 0, f)
    return out
}

nil map_into(T: type, U: type, xs: []T, out: *[]U, u64 i, f: function(T): U) {
    if i {
        xs.len: return
        _: {
            out[i] = f(xs[i])
            map_into(T, U, xs, out, i + 1, f)
        }
    }
}

-- fold: one value from all the elements, f(acc, x) from the first to the last.
fold(T: type, A: type, xs: []T, acc: A, f: function(A, T): A): A {
    return fold_from(T, A, xs, 0, acc, f)
}

fold_from(T: type, A: type, xs: []T, u64 i, acc: A, f: function(A, T): A): A {
    return if i {
        xs.len: acc
        _: fold_from(T, A, xs, i + 1, f(acc, xs[i]), f)
    }
}
