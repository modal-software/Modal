-- not bound in mod.modal: this module never leaves the domain

vault: struct {
    u32 code

}

open := (self: vault) u32 {
    return self.code
}

math: struct { }

u32 pow(self: math, b, x: u32): x * (b * b);
u32 pow2(self: math, b, x: u32): 2 * self.pow(b, x);

check(self: vault): u32 {

    self.code = math.pow2(8, 2) 

    self.code = self.code - 1

    write(self.code)
    return 1
}



main() {
    vault.check()
}
