-- no operating system: every byte print makes goes to the UART's data register, through the
-- program's `out`, and the UART counts them. main's result stays in x0 / eax when it returns.
print := import("std").io.print

uart: struct {
    u8 dr @ 0x00,     -- data
    u32 sent @ 0x04,  -- bytes sent (this test UART counts them)
}

send(self: uart, b: u8) {
    self.dr = b
    self.sent = self.sent + 1
}

uart0: uart @ 0x100_0000_0000

out: struct {
    u8 last,
}

new(self: out): self {
    return &self
}

put(self: out, b: u8) {
    self.last = b
    uart0.send(b)
}

u32 blink(u32 0): 0
u32 blink(n: u32): blink(n - 1) + 1

u32 times = 5 -- a variable: known only when the program runs, so blink is in the image

main(): u8 {
    out := out.new()
    print("blinks:", blink(times))
    return 42
}
