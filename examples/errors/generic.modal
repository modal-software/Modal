-- functions made once per type: each line of main below its first is an error
type := import("std").type
point: struct {
    i32 x,
}
rgb: struct {
    u8 r,
}
first(T: type, a: T, b: T): T {
    return a
}
main(): u8 {
    p := point{ x: 1 }
    c := rgb{ r: 1 }
    a := first(point, p, c)
    b := first(p, p, p)
    d := first(u8, 300, 1)
    return 0
}
