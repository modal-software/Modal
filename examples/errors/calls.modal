-- every invocation must lead to a declaration, and fit it

counter: struct {
    u8 total,

    bump(self, by: u8): u8 {
        return self.total + by
    }
}

read(self: counter): u8 {
    return self.total
}

double(n: u8): u8 {
    return n * 2
}

u8 scale(n: u8): n * 2
u8 scale(n, factor: u8): n * factor

main(c: counter): u8 {
    a := double(1)
    b := scale(1)
    d := scale(1, 2)
    ok := c.read()

    missing_function(a)
    e := double(1, 2)
    f := scale(1, 2, 3)
    g := a + unknown_name
    h := read(c)
    later_local(a)
    later_local := 1
    return 0
}

check(self: counter): u8 {
    i := self.bump(1)
    j := self.bump()
    k := self.nothing
    l := total
    return self.missing_method(1)
}

free(): u8 {
    return self.total
}
