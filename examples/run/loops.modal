-- Loops are recursion: a call that is a function's last act is a jump (a tail call), so a loop
-- of ten million runs in the stack of one call, on every backend.
print := import("std").io.print

-- a clause that calls its function again (through the clause before it)
u64 sum(u64 0, u64 acc): acc
u64 sum(u64 n, u64 acc): sum(n - 1, acc + n)

-- two functions calling each other
bool even(u64 0): true
bool even(u64 n): odd(n - 1)
bool odd(u64 0): false
bool odd(u64 n): even(n - 1)

-- a loop that prints along the way
bool count(u64 0): true
bool count(u64 n) {
    quiet := n > 3 or say(n)

    print("sum")
    return count(n - 1)
}
bool say(n: u64) {
    print("left", n)
    return true
}

main(): u8 {
    u64 n = 10000000
    print("sum", sum(n, 0))
    print("even", even(n), even(n + 1))
    count(n)
    return 0
}
