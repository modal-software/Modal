        -- even loop being invoked here he's a children of (f) and loop will not be execute until f be invoked
        loop(u64, n + 1)
        print(n)
    }
    -- here usage decides that f should be invoked
    n.(f).(_: print("finished"))
}

-- or



f := () {
    loop(u64, 1)
    print(n)
}

loop(T: type, n: T) {
    -- usage will analyse and decide if the pipe ops are sequentially (pipeline) or concurrent
    n.(0..10: n + 1).(f()).(_: print("finished"))
    -- sequentially: (check 0..10) -> increments n by 1 -> execute f that recursely executes loop, end of sequence.
    -- concurrent: (catches all) -> prints "finished" 

}

-- with lambdas and pipe operations
loop(T: type, n: T) {
    n.(0..10: {
        loop(u64, n+1);
        print(n)
    }
    ).(_: print("finished"))
}
