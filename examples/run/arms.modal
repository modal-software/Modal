-- Arms: `pattern: result`, tried in order; the first that takes the value gives the result.
-- A function body of arms matches its parameters (one pattern per parameter, `self` and
-- context parameters aside); `value { ... }` matches a value. A name takes any value and binds
-- it. Every value must be taken: the compiler names what is missing, and an arm that can never
-- run is an error.
print := import("std").io.print

u8 command([]u8 s) {
    "help": 1
    "quit": 2
    "": 4
    s: 0
}

[]u8 kind(c: u8) {
    48..57: "digit"
    32: "space"
    c: "other"
}

-- literals that cover every u8: no catch-all needed, and the last arm needs no test
[]u8 size(u8 n) {
    0: "none"
    1..9: "small"
    10..255: "big"
}

-- a loop: the arm's call is a tail call, so ten million turns run as a loop
u64 sum(u64 n, u64 acc) {
    0, acc: acc
    n, acc: sum(n - 1, acc + n)
}

nil countdown(u8 n) {
    0: print("go")
    n: {
        print(n)
        countdown(n - 1)
    }
}

[]u8 sign(i32 n) {
    -2147483648..-1: "negative"
    0: "zero"
    1..: "positive"
}

main(): u8 {
    u8 c = 50
    word := c {
        48..57: "a digit"
        c: "not a digit"
    }
    print(word, kind(c), kind(32), kind(7), size(0), size(5), size(200))
    print(command("help"), command("quit"), command(""), command("x"), sum(10000000, 0))
    c > 40 {
        true: print("above 40")
        false: print("40 or less")
    }
    i32 k = 0
    print(sign(k - 7), sign(k), sign(k + 7))
    doubled := c {
        0: 0
        n: n * 2
    }
    print("doubled", doubled)
    countdown(3)
    return 0
}
