-- Array results (context.md §64): a function returning `[N]T` writes it in its caller's place,
-- and the local it returns lives there (C: `m_ret`, no copy back). Every way of returning one.

print := import("std").io.print
type := import("std").type
map := import("std").map

[3]u16 one(a: []u16): a                     -- one line: a copy into the result
[3]u16 twice(a: []u16): one(a)              -- a call's result: written in place by the callee

[3]u16 build(u16 v) {
    [3]u16 out                              -- the result itself (starts at zero)
    out[0] = v
    out[2] = v + 2
    return out
}

[3]u16 again(u16 v) {
    return build(v * 10)                    -- passed on: a tail call
}

u64 sum(a: []u16): u64(a[0]) + u64(a[1]) + u64(a[2])

main(): u8 {
    [3]u16 a
    a[0] = 1
    a[2] = 9
    x := one(a)
    z := twice(a)
    b := build(4)
    c := again(5)
    d := map(c, v: v + 1)
    print(x[0], z[2], b[0], b[1], b[2], c[0], c[2], d[2])
    print(sum(one(a)), sum(build(7)), one(a)[2], build(3)[2])
    return 0
}
